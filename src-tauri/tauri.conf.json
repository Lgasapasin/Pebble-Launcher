{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pebble Launcher",
  "version": "0.2.0",
  "identifier": "io.pebble.launcher",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pebble Launcher",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 650,
        "backgroundColor": "#101019"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Minecraft launcher with secure multi-account management and isolated instances",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
